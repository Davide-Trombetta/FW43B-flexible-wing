FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// values computed by scripts/backgroundMesh
#include "meshVariables"

convertToMeters 1;

vertices
(
    ($xMin $yMin $zMin)
    ($xMax $yMin $zMin)
    ($xMax $yMax $zMin)
    ($xMin $yMax $zMin)
    ($xMin $yMin $zMax)
    ($xMax $yMin $zMax)
    ($xMax $yMax $zMax)
    ($xMin $yMax $zMax)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny $nz) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    freestream                      
    {                               
        type patch;
        faces $freestreamFaces;
    }
    midPlane                        
    {                               
        type symmetryPlane;
        faces $midPlaneFaces;
    }
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (2 6 5 1)
        );
    }
    ground                          // groundPlane wall: the bottom face;
    {                               // none: no faces (the bottom is free
        type wall;                  // stream, in freestreamFaces)
        inGroups (walls);
        faces $groundFaces;
    }
);

