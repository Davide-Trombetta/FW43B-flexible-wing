} > $OUT/results.tex
pdf
echo "Cd = $CD (min $CDMIN, max $CDMAX), Cl = $CL, over the last $WIN iterations; D = ${FDW:-?} N, L = ${FLW:-?} N, E = ${EFF:-?}"

#------------------------------------------------- metadata and summary
# every run self-describing (course slides "CFD simulation workflow"):
# source, parameters, environment, resources and outcome in
# report/results/metadata.yaml; the key metrics in one CSV line,
# report/results/summary.csv, the same columns for every run (grid study)
GIT=$(git rev-parse --short HEAD 2> /dev/null || echo none)
# uncommitted changes in the working copy
DIRTY=$(git status --porcelain 2> /dev/null | grep -q . && echo yes || echo no)
[ "$GIT" = none ] && DIRTY=-
# hash of the inputs (the recipe, not the results): independent of git
INPUTS=$(ls -d system constant 0.orig scripts tools Allrun Allrun.pre Allclean 2> /dev/null)
# hash of all the inputs
HASH=$(find $INPUTS -type f ! -path 'constant/polyMesh/*' ! -name meshVariables \
           ! -name reportGeometry ! -name rearRegions ! -name stlRegions ! -name regionForces \
           ! -path 'tools/bin/*' ! -path 'tools/stlInfo/build/*' ! -name '*.eMesh' ! -name '*.obj' \
           2> /dev/null | sort | xargs -r cat | sha256sum | cut -c1-16)
# OpenFOAM build: "Build : ..." line of the solver log
OFBUILD=$(grep -m1 "^Build" $LOGRUN 2> /dev/null | sed 's/^Build *: *//')
MPIV=$(mpirun --version 2> /dev/null | head -1)
GCCV=$(gcc --version 2> /dev/null | head -1)
RESLAST=$(tail -1 $OUT/residuals.csv 2> /dev/null | tr , ' ')
RESHEAD=$(head -1 $OUT/residuals.csv 2> /dev/null | tr , ' ')
# final residual of p / U: value under the column with that name
RESP=$(echo "$RESHEAD" "|" "$RESLAST" | awk -F'|' '{ n = split($1, h, " "); split($2, v, " ")
          for (i = 2; i <= n; i++) if (h[i] == "p") print v[i] }')
RESU=$(echo "$RESHEAD" "|" "$RESLAST" | awk -F'|' '{ n = split($1, h, " "); split($2, v, " ")
          for (i = 2; i <= n; i++) if (h[i] == "Ux" || h[i] == "U") { print v[i]; exit } }')
cat > $OUT/metadata.yaml <<EOY
# written by scripts/report results: source, parameters, environment,
# resources and outcome of this run
case: ${caseTitle:-case}
date: $(date '+%Y-%m-%d %H:%M:%S')
source:
  git: $GIT
  uncommittedChanges: $DIRTY
  inputsHash: $HASH       # sha256 of system/, constant/ (no mesh), 0.orig/, scripts/, tools/, Allrun*
parameters:
  flapAngle: ${ANGLE:-unknown}
  meshSize: ${meshSize:-}
  yPlus: $yPlus
  nWallLayers: $nWallLayers
  expansionRatio: $expansionRatio
  finalLayerThickness: ${finalLayerThickness:-}
  uInf: $uInf
  nu: $nu
  turbulenceModel: ${turbulenceModel:-}
  a1: ${A1:-}
  cdTolerance: ${cdTolerance:-none}
environment:
  openfoam: "${OFBUILD:-unknown}"
  compiler: "${GCCV:-unknown}"
  mpi: "${MPIV:-unknown}"
  host: $(hostname)
resources:
  cells: ${CELLS:-0}
  subdomains: $NPROC
  cpuTime_s: ${CPU:-0}
outcome:
  status: ${STATUS:-unknown}
  iterations: $NIT
  stableFrom: $FROM
  transientNotOver: $([ "$UNSTABLE" = 1 ] && echo yes || echo no)
  Cd: $CD
  CdStdError: $CDSE
  Cl: $CL
  ClStdError: $CLSE
  drag_N: ${FDW:-}          # whole wing
  downforce_N: ${FLW:-}     # whole wing, -F_z
  efficiency: ${EFF:-}      # downforce / drag
  finalResidualP: ${RESP:-}
  finalResidualU: ${RESU:-}
EOY
SUMH="case,flapAngle,uInf,mesh,cells,subdomains,cpuTime_s,iterations,status,stableFrom,Cd,CdStdError,Cl,ClStdError,drag_N,downforce_N,efficiency,finalResidualP,finalResidualU,git,inputsHash"
SUMV="${caseTitle:-case},${ANGLE:-},$uInf,${meshSize:-},${CELLS:-0},$NPROC,${CPU:-0},$NIT,${STATUS:-unknown},$FROM,$CD,$CDSE,$CL,$CLSE,${FDW:-},${FLW:-},${EFF:-},${RESP:-},${RESU:-},$GIT,$HASH"
printf "%s\n%s\n" "$SUMH" "$SUMV" > $OUT/summary.csv
# validation case: one line per run for the a1 study (tools/a1Table.py
# collects the validation.csv of all the runs)
if [ -n "$EXPROW" ]; then
    { echo "alpha,a1,mesh,cells,iterations,status,Cl_downforce,ClStdError,Cd,CdStdError,CL_exp,CD_exp,ClError_pct,CdError_pct"
      echo "$ANGLE,${A1:-},${meshSize:-},${CELLS:-0},$NIT,${STATUS:-unknown},$CLDOWN,$CLSE,$CD,$CDSE,$EXPCL,$EXPCD,$CLERR,$CDERRX"
    } > $OUT/validation.csv
fi
echo "summary: alpha ${ANGLE:-?} deg, a1 ${A1:-?}, ${uInf} m/s, mesh ${meshSize:-?}, ${CELLS:-?} cells, $NPROC subdomains, ${CPU:-?} s, $NIT iterations ($STATUS), Cd $CD +- $CDSE, Cl $CL, residuals p ${RESP:-?} U ${RESU:-?}"
