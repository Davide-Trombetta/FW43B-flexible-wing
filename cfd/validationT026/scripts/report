$(fig yplus_45_55 "\$y^+\$ from 4.5 to 5.5, the edge of the viscous sublayer (dark grey: below, light grey: above).")

\\section{Wall: shear stress}
$(fig wss_side "Skin-friction coefficient \$C_f = |\\tau_w| / (0.5 \\rho U_\\infty^2)\$ on the wing, side view (\\texttt{wallShearStress}); white: \$C_f\$ above twice the design value \$c_f\$ = \\num{$cf}.")
$(fig wss_top "\$C_f\$ on the wing, top view: low values where the flow separates (trailing edge at the centre of the span, endplate edges).")

\\section{Pressure on the wing}
$(fig cp_side "\$C_p\$ on the wing, side view.")
