$(fig cp0_iso "Iso-surface \$C_{p,\\mathrm{tot}} = 0\$, coloured by \$|U|/U_\\infty\$: the region where the flow has lost all its free-stream total pressure (separated flow and wake).")

\\section{Wake profiles}
$(fig profiles_u "Profiles of the stream-wise velocity \$u/U_\\infty\$ on the section \$y\$ = \\SI{$cutY}{m} behind the wing, at \$x/H\$ = 0.25, 0.5, 1, 1.5, 2 (\$x\$ from the trailing point, \$z\$ from the bottom of the wing elements).")
$(fig profiles_w "Profiles of the vertical velocity \$w/U_\\infty\$ at the same positions: upwash of the wake of a downforce wing.")
$(fig centreline "Wake line at mid-height of the wing: \$u/U_\\infty\$ and \$C_p\$ from the trailing point (\$x/H\$ = 0) to the end of the wake box.")

$([ -f $FIG/planes.tex ] && echo "\\clearpage" && echo "\\section{Flow-field planes}" && echo "\\num{${nPlanes:-16}} planes at constant distance along each principal direction (extracted by OpenFOAM in parallel, \\texttt{system/reportFunctions}), across the near box (wing and near wake): velocity magnitude, turbulent kinetic energy \$k\$, pressure and total-pressure coefficient. \$x\$ from the leading point (\$x/L\$), \$y\$ from the centre plane (\$y/W\$), \$z\$ from the bottom of the domain (\$z/H\$)." && echo "\\input{fig/planes.tex}")
