Patch & min & max & mean \\\\\\midrule
$YPROWS
\\bottomrule
\\end{tabular}
\\caption{\$y^+\$ of the first cell centre on each wall at the last iteration (function \\texttt{yPlus}); design value $yPlus at \$U_\\infty\$ = \\SI{$uInf}{m/s}.}
\\end{table}
YPT
)
$(fig yplus_body "\$y^+\$ on the wing (log scale).")
