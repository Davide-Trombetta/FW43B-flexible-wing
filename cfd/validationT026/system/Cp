#include "meshParameters"

type            pressure;
libs            (fieldFunctionObjects);
writeControl    writeTime;

mode            staticCoeff;
rho             rhoInf;
rhoInf          1;
pRef            0;
pInf            0;
UInf            ($uInf 0 0);
result          Cp;

