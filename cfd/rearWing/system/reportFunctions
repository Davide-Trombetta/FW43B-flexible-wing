FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      reportFunctions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Data for the images of the results report, extracted by OpenFOAM from the
// last time, in parallel on the decomposed case (run by scripts/report):
//
//   mpirun -np <N> simpleFoam -postProcess -parallel \
//          -dict system/reportFunctions -latestTime
//
// (OpenFOAM.org: foamPostProcess -solver incompressibleFluid). The solver in
// -postProcess mode builds its fields and turbulence model, then runs only
// these functions. Each one writes small surface / line files (VTK) in
// postProcessing/<function>/<time>/: ParaView (tools/report/images.py) reads
// only these and never the volume mesh. The positions are computed by
// scripts/postSetup (system/meshVariables, system/reportGeometry).

functions
{
    #includeFunc Q                // Q-criterion (field for the iso-surface)
    #includeFunc Cp0              // system/Cp0: total pressure coefficient
    #includeFunc planes           // system/planes: nPlanes cut planes per direction
    #includeFunc isoSurfaces      // system/isoSurfaces: Q and Cp0 = 0
    #includeFunc noseStreamlines  // system/noseStreamlines: from the leading edge
    #includeFunc wakeStreamlines  // system/wakeStreamlines: wake and tip vortices
}

