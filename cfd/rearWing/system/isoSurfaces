// Iso-surfaces of the vortical structures (results report), with U for the
// colour (|U|/Uinf):
//   Q   = qIso = QStar (uInf/H)^2   (scripts/postSetup, QStar in
//                                    constant/caseSettings)
//   Cp0 = 0                         (total-pressure loss of the free stream)
// Q and Cp0 are computed first (system/reportFunctions)
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "meshVariables"

type            surfaces;
libs            (sampling);
writeControl    writeTime;
surfaceFormat   vtk;
formatOptions   { vtk { legacy true; format binary; } }
interpolationScheme cellPoint;

fields          (U);

surfaces
{
    Q
    {
        type            isoSurface;
        isoField        Q;
        isoValue        $qIso;
        interpolate     true;
    }
    Cp0
    {
        type            isoSurface;
        isoField        Cp0;
        isoValue        0;
        interpolate     true;
    }
}

