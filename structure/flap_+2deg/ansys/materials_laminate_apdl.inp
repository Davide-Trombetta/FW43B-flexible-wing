! ======================================================================================
! FW43B(AR) rear wing - materials, element coordinate systems and layered shell sections (Mechanical APDL).
! Material data are literature / datasheet values (assumptions, not team data). Sources:
!  [1] Hexcel, HexPly 8552 Product Data Sheet (EU), 2023: IM7/8552 UD and AS4 plain-weave AGP193-PW/8552
!  [2] I.M. Daniel, O. Ishai, Engineering Mechanics of Composite Materials, 2nd ed., Oxford University Press,
!      2006, Appendix A: Table A.4 (IM7/977-3) and Table A.6 (AS4/3501-6 UD, AGP370-5H/3501-6S fabric)
!  [3] Aerospace Metals / ASM, Titanium Ti-6Al-4V (Grade 5), Annealed, data sheet
! Axes: 1 (x) along the fibres / warp, 2 (y) transverse in plane / fill, 3 (z) through the thickness.
! ======================================================================================
!
! --- 1: UD carbon/epoxy prepreg, intermediate modulus (IM7/8552)
MP,EX,1,164E9        ! E1          [1] IM7/8552, 0 deg tensile modulus, 25 C dry
MP,EY,1,12E9         ! E2          [1] IM7/8552, 90 deg tensile modulus, 25 C dry
MP,EZ,1,12E9         ! E3 = E2     transverse isotropy of a UD ply
MP,PRXY,1,0.35       ! nu12        [2] Table A.4, IM7/977-3
MP,PRXZ,1,0.35       ! nu13 = nu12 transverse isotropy
MP,PRYZ,1,0.54       ! nu23        [2] Table A.6, AS4/3501-6
MP,GXY,1,7.8E9       ! G12         [2] Table A.4, IM7/977-3
MP,GXZ,1,7.8E9       ! G13 = G12   transverse isotropy
MP,GYZ,1,3.7E9       ! G23         [2] Table A.6, AS4/3501-6 (check: E2/(2(1+nu23)) = 3.9 GPa)
MP,DENS,1,1570       ! density     [1] IM7/8552 nominal laminate density 1.57 g/cm3
!
! --- 2: woven carbon/epoxy fabric (5-harness satin, AGP370-5H/3501-6S), outer plies
MP,EX,2,77E9         ! E1 (warp)   [2] Table A.6
MP,EY,2,75E9         ! E2 (fill)   [2] Table A.6
MP,EZ,2,13.8E9       ! E3          [2] Table A.6
MP,PRXY,2,0.06       ! nu12        [2] Table A.6
MP,PRXZ,2,0.50       ! nu13        [2] Table A.6
MP,PRYZ,2,0.37       ! nu23        [2] Table A.6
MP,GXY,2,6.5E9       ! G12         [2] Table A.6
MP,GXZ,2,5.1E9       ! G13         [2] Table A.6
MP,GYZ,2,4.1E9       ! G23         [2] Table A.6
MP,DENS,2,1600       ! density     [2] Table A.6, 1.60 g/cm3
!
! --- 3: titanium alloy Ti-6Al-4V, Grade 5, annealed (DRS link)
MP,EX,3,113.8E9      ! E           [3]
MP,PRXY,3,0.342      ! nu          [3]
MP,DENS,3,4430       ! density     [3] 4.43 g/cm3
!
! --- 0 deg directions: for shells the element x axis is the projection of the ESYS x axis on the shell
LOCAL,11,0,0,0,0,90          ! x along global +y (span): main plane, flap
LOCAL,12,0,0,0,0,0,0,-90     ! x along global +z (vertical): endplates, pod, swan necks, pylons
CSYS,0
!
! --- layered sections: SECDATA, ply thickness [m], material, angle [deg], integration points (bottom -> top)
!     the angle is measured from the element x axis (ESYS 11 or 12, set per region in the mesh file)
!     ply thickness: UD 0.131 mm [1] (IM7/8552 nominal cured ply), fabric 0.195 mm [1] (AGP193-PW cured ply)
! section 1: MAINPLANE - [F/0/45/-45/0]s, 1.438 mm, 0 deg along the span
SECTYPE,1,SHELL
SECDATA,0.000195,2,0,3
SECDATA,0.000131,1,0,3
SECDATA,0.000131,1,45,3
SECDATA,0.000131,1,-45,3
SECDATA,0.000131,1,0,3
SECDATA,0.000131,1,0,3
SECDATA,0.000131,1,-45,3
SECDATA,0.000131,1,45,3
SECDATA,0.000131,1,0,3
SECDATA,0.000195,2,0,3
SECOFFSET,MID
! section 2: FLAP - [F/0/45/-45/0]s, 1.438 mm, 0 deg along the span
SECTYPE,2,SHELL
SECDATA,0.000195,2,0,3
SECDATA,0.000131,1,0,3
SECDATA,0.000131,1,45,3
SECDATA,0.000131,1,-45,3
