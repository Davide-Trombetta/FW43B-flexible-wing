SECDATA,0.000195,2,0,3
SECOFFSET,MID
! section 6: ENDPLATE_YPOS - [F/0/45/-45/0]s, 1.438 mm, 0 deg vertical
SECTYPE,6,SHELL
SECDATA,0.000195,2,0,3
SECDATA,0.000131,1,0,3
SECDATA,0.000131,1,45,3
SECDATA,0.000131,1,-45,3
SECDATA,0.000131,1,0,3
