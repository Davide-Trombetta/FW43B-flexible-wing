! section 8: PYLONS forks - [F/0/0/45/-45/0/0]s, 1.962 mm, 0 deg vertical
SECTYPE,8,SHELL
SECDATA,0.000195,2,0,3
SECDATA,0.000131,1,0,3
SECDATA,0.000131,1,0,3
SECDATA,0.000131,1,45,3
SECDATA,0.000131,1,-45,3
