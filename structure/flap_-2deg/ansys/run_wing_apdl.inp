! ======================================================================================
! FW43B(AR) rear wing - static analysis in Mechanical APDL (composite shell model).
! Run: Mechanical APDL Product Launcher -> working directory = this folder -> run in batch with this input,
!      or in the GUI: File > Read Input from... run_wing_apdl.inp
! Files needed in the same folder:
!   rw_shell_medium_apdl.inp        mesh (structure/flap_0deg also has coarse and fine: change the /INPUT line)
!   materials_laminate_apdl.inp
!   loads_pressure_apdl.inp         from the repository root:
!     python3 fsi/map_pressure.py structure/flap_-2deg/ansys/rw_shell_medium_apdl.inp <vtk files> \
!             -o structure/flap_-2deg/ansys/loads_pressure_apdl.inp
! Load step 1: self weight only (check: vertical reaction = weight, about 61.5 N).
! Load step 2: aerodynamic pressure only (check: reactions = - force printed by map_pressure.py).
! Output: reactions in the .out file / output window, wing_disp.csv (step 2) for the CFD mesh morphing.
! ======================================================================================
/TITLE,FW43B(AR) rear wing - flap -2 deg - composite shell model - static
/PREP7
/INPUT,materials_laminate_apdl,inp
/INPUT,rw_shell_medium_apdl,inp
! --- constraints: translations fixed at the pylon base and at the endplate feet
CMSEL,S,N_SUPPORT
D,ALL,UX,0
D,ALL,UY,0
D,ALL,UZ,0
ALLSEL,ALL
FINISH
!
/SOLU
ANTYPE,STATIC
OUTRES,ALL,ALL
! --- load step 1: self weight (ACEL = acceleration opposite to gravity)
ACEL,0,0,9.81
SOLVE
! --- load step 2: aerodynamic pressure only
ACEL,0,0,0
/INPUT,loads_pressure_apdl,inp
SOLVE
FINISH
!
/POST1
! --- reactions (totals at the end of each list)
SET,1
CMSEL,S,N_SUPPORT
/COM, === LOAD STEP 1 (self weight): reaction forces at the supports ===
PRRSOL,F
ALLSEL,ALL
SET,2
CMSEL,S,N_SUPPORT
/COM, === LOAD STEP 2 (aerodynamic pressure): reaction forces at the supports ===
PRRSOL,F
ALLSEL,ALL
! --- displacements of load step 2 -> wing_disp.csv  (X Y Z UX UY UZ, metres, undeformed coordinates)
*GET,NMAX,NODE,0,NUM,MAX
*DIM,T,ARRAY,NMAX,6
*VGET,T(1,1),NODE,1,LOC,X
*VGET,T(1,2),NODE,1,LOC,Y
*VGET,T(1,3),NODE,1,LOC,Z
*VGET,T(1,4),NODE,1,U,X
*VGET,T(1,5),NODE,1,U,Y
*VGET,T(1,6),NODE,1,U,Z
*CFOPEN,wing_disp,csv
*VWRITE,T(1,1),T(1,2),T(1,3),T(1,4),T(1,5),T(1,6)
(E16.8,',',E16.8,',',E16.8,',',E16.8,',',E16.8,',',E16.8)
*CFCLOS
/COM, === wing_disp.csv written (load step 2) ===
FINISH
